{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-backend",
      "detail": "FastAPI on http://localhost:8000",
      "type": "shell",
      "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "smartevent",
        "panel": "dedicated",
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "start-frontend",
      "detail": "Vite dev server on http://localhost:5173",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "smartevent",
        "panel": "dedicated",
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "run-smartevent",
      "detail": "Starts backend + frontend together",
      "dependsOn": ["start-backend", "start-frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}